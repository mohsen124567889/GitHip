rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  match /users/{uid}{allow read:if signed();allow create,update:if signed()&&request.auth.uid==uid;allow delete:if signed()&&request.auth.uid==uid;}
  match /chats/{chatId}{
   function member(){return signed()&&request.auth.uid in resource.data.members;}
   allow read,create:if signed()&&(request.auth.uid in request.resource.data.members||member());
   allow update:if member()&&request.resource.data.members==resource.data.members;
   allow delete:if member();
   match /messages/{mid}{allow read,create:if signed()&&request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;allow update,delete:if false;}
  }
  match /calls/{callId}{
   allow read,create,update:if signed()&&(request.auth.uid==resource.data.caller||request.auth.uid==resource.data.callee||request.auth.uid==request.resource.data.caller||request.auth.uid==request.resource.data.callee);
   match /{sub=**}{allow read,write:if signed();}
  }
 }
}
