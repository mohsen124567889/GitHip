rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  match /users/{uid}{allow read:if signed();allow create,update:if signed()&&request.auth.uid==uid;}
  match /chats/{chatId}{
   allow read:if signed()&&request.auth.uid in resource.data.members;
   allow create:if signed()&&request.auth.uid in request.resource.data.members;
   allow update:if signed()&&request.auth.uid in resource.data.members;
   match /messages/{mid}{
    allow read:if signed()&&request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    allow create:if signed()&&request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members&&request.resource.data.sender==request.auth.uid;
   }
  }
 }
}
